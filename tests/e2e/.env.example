# Copy to .env, which is gitignored. Real environment variables win over this
# file, so CI can set its own values without the file interfering.
#
# The defaults below target a local wp-env instance. Anything that mirrors live
# state is written for you: scripts/bootstrap-wp.sh fills in E2E_WP_APP_PASSWORD
# and E2E_PLUGIN_ENV, and rig/mode.sh fills in E2E_API_MODE.

# Where WordPress is. http, not https: wp-env serves plain HTTP, and an https
# default fails on the first navigation with a TLS error that reads like a bug.
BASE_URL=http://localhost:8894

# Browser login. wp-env's documented defaults.
E2E_WP_USER=admin
E2E_WP_PASSWORD=password

# REST Basic auth. A WordPress application password, NOT the account password
# above: WordPress only accepts application passwords for Basic auth. Generated
# per install, so there is no default. Run scripts/bootstrap-wp.sh to mint one.
E2E_WP_APP_PASSWORD=

# live | reject. Written by rig/mode.sh as it switches the container, so the
# variable and the container cannot drift apart.
E2E_API_MODE=live

# production | staging. The plugin's configured environment changes which error
# text reaches the editor, and the error specs assert on that difference.
# Written by scripts/bootstrap-wp.sh, read from WordPress.
E2E_PLUGIN_ENV=production

# Override any timeout tier in milliseconds. See constants/timeouts.ts.
# E2E_TIMEOUT_MEDIUM=
