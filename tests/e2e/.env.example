# Copy to .env, which is gitignored. Real environment variables win over this
# file, so CI can set its own values without the file interfering.
#
# The defaults below target a local wp-env instance. scripts/bootstrap-wp.sh
# persists the connection details and configures the plugin for a Ceros env.

# Where WordPress is. http, not https: wp-env serves plain HTTP, and an https
# default fails on the first navigation with a TLS error that reads like a bug.
BASE_URL=http://localhost:8888

# Admin login. wp-env's documented defaults. Global setup signs in once with
# these; the persisted session (cookies + REST nonce) then authenticates both
# the browser and the REST calls, so there is no application password to manage.
E2E_WP_USER=admin
E2E_WP_PASSWORD=password

# The Ceros dev environment the suite targets. Everything else — the experience
# URLs the paste-URL specs resolve and the API host the plugin calls — derives
# from it. Set to a PR env or another dev env to point the whole suite there.
# Whatever runs the suite must be able to reach that env's hosts.
E2E_CEROS_ENV=latest

# API key for that environment — a Bearer secret, so NO default. Set it in .env
# locally (a CI secret in the pipeline). Required for the browse-picker specs;
# paste-URL and not-found run without it. A different env needs its own key.
E2E_CEROS_API_KEY=

# Override any timeout tier in milliseconds. See constants/timeouts.ts.
# E2E_TIMEOUT_MEDIUM=
