#!/usr/bin/env bash
#
# Block a push while PHPCS reports violations or the unit suite fails.
#
# Note this checks the working tree, not the exact commits being pushed — if the
# tree is dirty, that dirt is what gets checked. Matching the pushed refs
# exactly would mean checking each one out, which is not worth the complexity
# for a local convenience gate. CI is the real authority.
#
# The unit suite is safe to run here because it needs no WordPress, database or
# network and finishes in milliseconds. An integration suite would not be.
#
# Bypass with `git push --no-verify`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

for bin in phpcs phpunit; do
	if [ ! -x "vendor/bin/$bin" ]; then
		echo "pre-push: vendor/bin/$bin not found — run 'composer install'." >&2
		exit 1
	fi
done

echo "pre-push: running composer lint…"

if ! composer lint; then
	echo >&2
	echo "pre-push: lint failed. Run 'composer lint:fix' for the mechanical" >&2
	echo "fixes, then resolve whatever is left by hand." >&2
	echo "To push regardless: git push --no-verify" >&2
	exit 1
fi

echo "pre-push: running composer test…"

if ! composer test; then
	echo >&2
	echo "pre-push: unit tests failed. Run 'composer test' to reproduce." >&2
	echo "To push regardless: git push --no-verify" >&2
	exit 1
fi

exit 0
