#!/usr/bin/env bash
#
# Block a push while PHPCS, PHPUnit, ESLint or Stylelint report a problem.
#
# Note this checks the working tree, not the exact commits being pushed — if the
# tree is dirty, that dirt is what gets checked. Matching the pushed refs
# exactly would mean checking each one out, which is not worth the complexity
# for a local convenience gate. CI is the real authority.
#
# The unit suite is safe to run here because it needs no WordPress, database or
# network and finishes in milliseconds. An integration suite would not be.
#
# Bypass with `git push --no-verify`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# First, because it needs neither composer nor npm: a mismatch here is cheap to
# catch and the most common thing a release forgets.
echo "pre-push: running tools/check-versions.sh…"

if ! bash tools/check-versions.sh; then
	echo >&2
	echo "pre-push: the plugin's version declarations disagree. Move them all, or" >&2
	echo "push regardless: git push --no-verify" >&2
	exit 1
fi

for bin in phpcs phpunit; do
	if [ ! -x "vendor/bin/$bin" ]; then
		echo "pre-push: vendor/bin/$bin not found — run 'composer install'." >&2
		exit 1
	fi
done

if [ ! -d node_modules ]; then
	echo "pre-push: node_modules not found — run 'npm ci'." >&2
	exit 1
fi

echo "pre-push: running composer lint…"

if ! composer lint; then
	echo >&2
	echo "pre-push: lint failed. Run 'composer lint:fix' for the mechanical" >&2
	echo "fixes, then resolve whatever is left by hand." >&2
	echo "To push regardless: git push --no-verify" >&2
	exit 1
fi

echo "pre-push: running composer test…"

if ! composer test; then
	echo >&2
	echo "pre-push: unit tests failed. Run 'composer test' to reproduce." >&2
	echo "To push regardless: git push --no-verify" >&2
	exit 1
fi

echo "pre-push: running npm run lint:js…"

if ! npm run --silent lint:js; then
	echo >&2
	echo "pre-push: JS lint failed. Run 'npm run lint:js -- --fix' for the" >&2
	echo "mechanical fixes, then resolve whatever is left by hand." >&2
	echo "To push regardless: git push --no-verify" >&2
	exit 1
fi

echo "pre-push: running npm run test:js…"

if ! npm run --silent test:js; then
	echo >&2
	echo "pre-push: JS tests failed. Run 'npm run test:js' to reproduce." >&2
	echo "To push regardless: git push --no-verify" >&2
	exit 1
fi

echo "pre-push: running npm run lint:css…"

if ! npm run --silent lint:css; then
	echo >&2
	echo "pre-push: CSS lint failed. Run 'npm run lint:css -- --fix' for the" >&2
	echo "mechanical fixes, then resolve whatever is left by hand." >&2
	echo "To push regardless: git push --no-verify" >&2
	exit 1
fi

exit 0
